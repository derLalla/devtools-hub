# --- Application ---
# Port the HTTP server listens on
PORT=3000

# --- MongoDB ---
# Connection string for MongoDB. When running via docker-compose the host is "mongo".
MONGO_URI=mongodb://mongo:27017/devtools

# --- Auth ---
# REQUIRED in production. Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Initial admin user ---
# Used by the seeder on first boot. Change before any non-local deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Static assets (optional override) ---
# Absolute or relative path to the built Vue SPA. Defaults to ./web inside the container.
# STATIC_DIR=./web
